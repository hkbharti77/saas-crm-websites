rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Blog Posts Collection Security Rules
    match /blogs/{blogId} {
      // Public visitors can only read published posts
      allow read: if (resource.data.status != 'draft' && resource.data.status != 'scheduled' && resource.data.status != 'archived') || (request.auth != null);
      allow write: if request.auth != null;
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /media/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blog_versions/{docId} {
      allow read, write: if request.auth != null;
    }

    match /blog_activity/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Cookie Consent Analytics
    match /cookie_consents/{docId} {
      // Anonymous visitors can record their cookie consent decision
      allow create: if true;
      // Only authenticated admins can read or manage consent records
      allow read, update, delete: if request.auth != null;
    }

    // Blog Analytics Daily Collection
    match /analytics_blog_daily/{docId} {
      // Anonymous visitors can record/increment daily analytics (create & update)
      allow create, update: if true;
      // Only authenticated admins can read analytics data or delete records
      allow read, delete: if request.auth != null;
    }
    
    // Fallback: Deny all other unauthenticated access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
